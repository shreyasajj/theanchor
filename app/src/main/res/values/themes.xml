<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark. The window background matches the Compose theme so the
         lock screens never flash white at 5 AM. -->
    <style name="Theme.Anchor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/anchor_black</item>
        <item name="android:statusBarColor">@color/anchor_black</item>
        <item name="android:navigationBarColor">@color/anchor_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- For the small confirmation sheet shown over another app. -->
    <style name="Theme.Anchor.Translucent" parent="Theme.Anchor">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
